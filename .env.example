# PostgreSQL
PG_DATABASE=your_database_name
PG_USER=your_username
PG_PASSWORD=your_password
PG_HOST=localhost
PG_PORT=5432

# BT API OAuth
CONSUMER_KEY=your_bt_consumer_key
CONSUMER_SECRET=your_bt_consumer_secret

# AWS
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=eu-west-2

# S3
BASE_DIR=s3://hsds-data/

# London Datastore
LDS_API_KEY=your_lds_api_key

# GLA internal package (private repo)
GITHUB_ACCESS_TOKEN_GLAPY=your_github_token

# Snowflake (LDC pipeline)
GS_USER=your_snowflake_user
GS_PASSWORD=your_snowflake_password
GS_ACCT_ID=your_snowflake_account
GS_DATABASE=your_snowflake_database
GS_SCHEMA=SCH_GREEN_STREET
GS_WAREHOUSE=your_warehouse
GS_ROLE=your_role

# SFTP (Mastercard file transfer)
SFTP_HOST=your_sftp_host
SFTP_PORT=22
SFTP_USERNAME=your_sftp_username
SFTP_PASSWORD=your_sftp_password

# TravelTime (isochrone generator, optional)
TRAVELTIME_APP_ID=your_traveltime_app_id
TRAVELTIME_API_KEY=your_traveltime_api_key

# Mastercard (optional)
YOY_FILE=path_to_yoy_file
